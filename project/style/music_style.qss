/* 音频播放器浅色样式 */
MusicPlay {
    background: #F4F6F8;
}

QLabel {
    color: #1F2937;
}

#listWidget {
    background: transparent;
    border: none;
}
#listWidget::item {
    padding: 8px;
    border-radius: 6px;
}
#listWidget::item:selected {
    background: #EFF6FF;
    color: #2F7CF6;
}

#btn_previous, #btn_next {
    min-width: 64px;
    max-width: 64px;
    min-height: 64px;
    max-height: 64px;
    border-radius: 32px;
    background: #FFFFFF;
    border: 1px solid #E5E7EB;
    padding: 0;
}
#btn_play {
    min-width: 72px;
    max-width: 72px;
    min-height: 72px;
    max-height: 72px;
    border-radius: 36px;
    background: #2F7CF6;
    border: none;
    padding: 0;
}
#btn_favorite, #btn_mode, #btn_menu, #btn_volume {
    min-width: 36px;
    max-width: 36px;
    min-height: 36px;
    max-height: 36px;
    border-radius: 18px;
    background: transparent;
    border: none;
    padding: 0;
}
